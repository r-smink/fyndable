{% comment %}
  Fyndable SEO schema (app embed).

  1. Schema saved per item in the app (metafields fyndable.*_schema and
     fyndable.faq_schema) always wins.
  2. Store-wide structured data (1.4), switched on/off in the app and
     published as the app-data metafield fyndable.schema_config:
     Organization / LocalBusiness and WebSite + SearchAction on the home page,
     BreadcrumbList, and automatic Product and BlogPosting schema built from
     the storefront data (always current, no API calls).
  Only JSON-LD is output; no JavaScript.
{% endcomment %}
{%- assign fyndable_cfg = app.metafields.fyndable.schema_config.value -%}
{%- assign fyndable_shop_url = request.origin | default: shop.url -%}

{% assign fyndable_schema = nil %}
{% if product and product.metafields.fyndable.product_schema.value %}
  {% assign fyndable_schema = product.metafields.fyndable.product_schema.value %}
{% elsif collection and collection.metafields.fyndable.collection_schema.value %}
  {% assign fyndable_schema = collection.metafields.fyndable.collection_schema.value %}
{% elsif page and page.metafields.fyndable.page_schema.value %}
  {% assign fyndable_schema = page.metafields.fyndable.page_schema.value %}
{% elsif article and article.metafields.fyndable.article_schema.value %}
  {% assign fyndable_schema = article.metafields.fyndable.article_schema.value %}
{% endif %}

{% if fyndable_schema %}
<script type="application/ld+json" data-fyndable="item">
  {{ fyndable_schema | json }}
</script>
{% endif %}

{% comment %} FAQ schema: separate metafield, can coexist with the main schema. {% endcomment %}
{% assign fyndable_faq = nil %}
{% if product and product.metafields.fyndable.faq_schema.value %}
  {% assign fyndable_faq = product.metafields.fyndable.faq_schema.value %}
{% elsif collection and collection.metafields.fyndable.faq_schema.value %}
  {% assign fyndable_faq = collection.metafields.fyndable.faq_schema.value %}
{% elsif page and page.metafields.fyndable.faq_schema.value %}
  {% assign fyndable_faq = page.metafields.fyndable.faq_schema.value %}
{% elsif article and article.metafields.fyndable.faq_schema.value %}
  {% assign fyndable_faq = article.metafields.fyndable.faq_schema.value %}
{% endif %}

{% if fyndable_faq %}
<script type="application/ld+json" data-fyndable="faq">
  {{ fyndable_faq | json }}
</script>
{% endif %}

{%- if fyndable_cfg -%}

  {%- comment -%} Home page: Organization, LocalBusiness and WebSite + SearchAction. {%- endcomment -%}
  {%- if request.page_type == 'index' -%}
    {%- for fyndable_block in fyndable_cfg.home -%}
<script type="application/ld+json" data-fyndable="store">{{ fyndable_block | json }}</script>
    {%- endfor -%}
    {%- if fyndable_cfg.website -%}
<script type="application/ld+json" data-fyndable="website">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": {{ fyndable_shop_url | append: '/#website' | json }},
  "name": {{ shop.name | json }},
  "url": {{ fyndable_shop_url | append: '/' | json }},
  {%- if fyndable_cfg.organization_id -%}"publisher": { "@id": {{ fyndable_cfg.organization_id | json }} },{%- endif -%}
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ fyndable_shop_url | append: routes.search_url | append: '?q={search_term_string}' | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} BreadcrumbList: Home > (collection | blog) > item. {%- endcomment -%}
  {%- if fyndable_cfg.breadcrumbs and request.page_type != 'index' -%}
    {%- assign fyndable_crumb_name = '' -%}
    {%- assign fyndable_crumb_url = '' -%}
    {%- assign fyndable_parent_name = '' -%}
    {%- assign fyndable_parent_url = '' -%}
    {%- case request.page_type -%}
      {%- when 'product' -%}
        {%- assign fyndable_crumb_name = product.title -%}
        {%- assign fyndable_crumb_url = product.url -%}
        {%- if collection -%}
          {%- assign fyndable_parent_name = collection.title -%}
          {%- assign fyndable_parent_url = collection.url -%}
        {%- endif -%}
      {%- when 'collection' -%}
        {%- assign fyndable_crumb_name = collection.title -%}
        {%- assign fyndable_crumb_url = collection.url -%}
      {%- when 'article' -%}
        {%- assign fyndable_crumb_name = article.title -%}
        {%- assign fyndable_crumb_url = article.url -%}
        {%- assign fyndable_parent_name = blog.title -%}
        {%- assign fyndable_parent_url = blog.url -%}
      {%- when 'blog' -%}
        {%- assign fyndable_crumb_name = blog.title -%}
        {%- assign fyndable_crumb_url = blog.url -%}
      {%- when 'page' -%}
        {%- assign fyndable_crumb_name = page.title -%}
        {%- assign fyndable_crumb_url = page.url -%}
    {%- endcase -%}
    {%- if fyndable_crumb_name != blank -%}
<script type="application/ld+json" data-fyndable="breadcrumbs">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ fyndable_shop_url | append: routes.root_url | json }} },
    {%- if fyndable_parent_name != blank -%}
    { "@type": "ListItem", "position": 2, "name": {{ fyndable_parent_name | json }}, "item": {{ fyndable_shop_url | append: fyndable_parent_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ fyndable_crumb_name | json }}, "item": {{ fyndable_shop_url | append: fyndable_crumb_url | json }} }
    {%- else -%}
    { "@type": "ListItem", "position": 2, "name": {{ fyndable_crumb_name | json }}, "item": {{ fyndable_shop_url | append: fyndable_crumb_url | json }} }
    {%- endif -%}
  ]
}
</script>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} Automatic Product schema when no item schema was saved. {%- endcomment -%}
  {%- if fyndable_cfg.product and request.page_type == 'product' and product and fyndable_schema == nil -%}
    {%- assign fyndable_variant = product.selected_or_first_available_variant -%}
<script type="application/ld+json" data-fyndable="product">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ fyndable_shop_url | append: product.url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "url": {{ fyndable_shop_url | append: product.url | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 5000 | json }},
  {%- if product.images.size > 0 -%}
  "image": [{%- for fyndable_image in product.images limit: 5 -%}{{ fyndable_image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  {%- endif -%}
  {%- if product.vendor != blank -%}"brand": { "@type": "Brand", "name": {{ product.vendor | json }} },{%- endif -%}
  {%- if fyndable_variant.sku != blank -%}"sku": {{ fyndable_variant.sku | json }},{%- endif -%}
  {%- if product.metafields.reviews.rating.value and product.metafields.reviews.rating_count.value > 0 -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
    "bestRating": {{ product.metafields.reviews.rating.value.scale_max | json }},
    "worstRating": {{ product.metafields.reviews.rating.value.scale_min | json }},
    "ratingCount": {{ product.metafields.reviews.rating_count.value | json }}
  },
  {%- endif -%}
  "offers": [
    {%- for fyndable_v in product.variants limit: 100 -%}
    {%- assign fyndable_barcode = fyndable_v.barcode | remove: ' ' -%}
    {
      "@type": "Offer",
      "url": {{ fyndable_shop_url | append: fyndable_v.url | json }},
      "price": {{ fyndable_v.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": {% if fyndable_v.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      "itemCondition": "https://schema.org/NewCondition",
      {%- if fyndable_v.sku != blank -%}"sku": {{ fyndable_v.sku | json }},{%- endif -%}
      {%- if fyndable_barcode.size == 8 or fyndable_barcode.size == 12 or fyndable_barcode.size == 13 or fyndable_barcode.size == 14 -%}"gtin": {{ fyndable_barcode | json }},{%- endif -%}
      "name": {{ fyndable_v.title | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
  {%- endif -%}

  {%- comment -%} Automatic BlogPosting schema when no article schema was saved. {%- endcomment -%}
  {%- if fyndable_cfg.article and request.page_type == 'article' and article and fyndable_schema == nil -%}
<script type="application/ld+json" data-fyndable="article">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | truncate: 110 | json }},
  "url": {{ fyndable_shop_url | append: article.url | json }},
  "mainEntityOfPage": {{ fyndable_shop_url | append: article.url | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  {%- if article.image -%}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
  "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 300 | json }},
  {%- if fyndable_cfg.organization_id -%}"publisher": { "@id": {{ fyndable_cfg.organization_id | json }} },{%- endif -%}
  "author": { "@type": "Person", "name": {{ article.author | json }} }
}
</script>
  {%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "Fyndable SEO schema",
  "target": "body",
  "settings": []
}
{% endschema %}
