{% comment %}
  Fyndable collection FAQ (2.5): visible questions and answers below the
  products (metafield fyndable.collection_landing). The FAQPage schema is
  output by the Fyndable SEO schema app embed (fyndable.faq_schema).
{% endcomment %}
{%- assign fyndable_landing = collection.metafields.fyndable.collection_landing.value -%}
{%- if fyndable_landing.faq.size > 0 -%}
<div class="fyndable-collection-faq page-width" style="margin-top: {{ block.settings.spacing }}px; margin-bottom: {{ block.settings.spacing }}px;">
  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | escape }}</h2>{%- endif -%}
  {%- for fyndable_item in fyndable_landing.faq -%}
    <details{% if forloop.first and block.settings.open_first %} open{% endif %} style="border-bottom: 1px solid rgba(0,0,0,.1); padding: 12px 0;">
      <summary style="cursor: pointer; font-weight: 600;">{{ fyndable_item.question | escape }}</summary>
      <p style="margin: 8px 0 0;">{{ fyndable_item.answer | escape }}</p>
    </details>
  {%- endfor -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Fyndable collection FAQ",
  "target": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": false },
    { "type": "range", "id": "spacing", "label": "Spacing", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 24 }
  ]
}
{% endschema %}
