APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shopify app credentials (from the Shopify Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_content,write_content,read_themes,read_metaobjects,write_metaobjects,write_app_proxy,read_markets,read_locales,read_translations
SHOPIFY_API_VERSION=2026-07
SHOPIFY_REDIRECT_URI=/auth/callback
SHOPIFY_WEBHOOK_URI=/webhooks
SHOPIFY_IS_EMBEDDED=true

# Fyndable SaaS dashboard connection
SAAS_DASHBOARD_URL=https://portal.fyndable.ai
SAAS_API_NAMESPACE=ai-seo-saas/v1

# Shopify App Pricing (plans are managed in the Partner Dashboard)
# Set SHOPIFY_BILLING_ENABLED=true in production: the app then requires a
# plan (or the in-app trial) and syncs the subscription to the SaaS.
SHOPIFY_BILLING_ENABLED=false
SHOPIFY_PARTNER_ID=5185442
SHOPIFY_APP_ID=423617626113
SHOPIFY_APP_HANDLE=fyndable-smart-seo
# Partner API client token (Dev Dashboard > Organization settings > Partner API clients, permission "Manage apps")
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_API_VERSION=2026-10
# Shared secret with the SaaS dashboard (wp-config FYNDABLE_SHOPIFY_SYNC_SECRET)
FYNDABLE_SHOPIFY_SYNC_SECRET=
