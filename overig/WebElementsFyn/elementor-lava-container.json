osition:absolute;left:52%;top:108%;width:80px;height:80px;margin-left:-40px;border-radius:50%;background:linear-gradient(160deg,#a24fc0,#4b8fd8);animation:fynRise 24s -3s cubic-bezier(.45,0,.55,1) infinite alternate\"></span><span style=\"position:absolute;left:64%;top:108%;width:130px;height:130px;margin-left:-65px;border-radius:50%;background:linear-gradient(160deg,#4b8fd8,#8F39AC);animation:fynRise 29s -19s cubic-bezier(.45,0,.55,1) infinite alternate\"></span><span style=\"position:absolute;left:78%;top:108%;width:100px;height:100px;margin-left:-50px;border-radius:50%;background:linear-gradient(160deg,#8F39AC,#379FD3);animation:fynRise 23s -9s cubic-bezier(.45,0,.55,1) infinite alternate\"></span><span style=\"position:absolute;left:88%;top:108%;width:70px;height:70px;margin-left:-35px;border-radius:50%;background:linear-gradient(160deg,#379FD3,#6a5fc4);animation:fynRise 31s -24s cubic-bezier(.45,0,.55,1) infinite alternate\"></span><span style=\"position:absolute;left:30%;top:108%;width:60px;height:60px;margin-left:-30px;border-radius:50%;background:linear-gradient(160deg,#6a5fc4,#a24fc0);animation:fynRise 19s -11s cubic-bezier(.45,0,.55,1) infinite alternate\"></span><span style=\"position:absolute;left:-10%;right:-10%;bottom:-120px;height:220px;border-radius:50%;background:linear-gradient(90deg,#8F39AC,#379FD3);animation:fynPool 9s ease-in-out infinite\"></span><span style=\"position:absolute;left:-10%;right:-10%;top:-150px;height:210px;border-radius:50%;background:linear-gradient(90deg,#379FD3,#8F39AC);animation:fynPool 11s ease-in-out infinite reverse\"></span></div></div>",
