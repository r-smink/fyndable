      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='changeTone'] > Literal[value!=/^(?:positive|negative)$/]",
        "message": "<StatCard> changeTone must be one of 'positive' | 'negative'."
