      "html": "<style>\n@keyframes fynRowIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.fyn-cmp .fyn-anim{animation:fynRowIn .45s ease both}.fyn-cmp{font-family:Outfit,sans-serif}\n.fyn-cmp .fyn-pills{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-bottom:32px}\n.fyn-cmp .fyn-pill{cursor:pointer;font:500 13px/1 Outfit,sans-serif;padding:10px 16px;border-radius:20px;border:2px solid #e5e7eb;background:#fff;color:#4b5563;transition:all .2s ease}\n.fyn-cmp .fyn-pill:hover{border-color:#8F39AC;color:#8F39AC}\n.fyn-cmp .fyn-pill.on{background:linear-gradient(135deg,#8F39AC,#379FD3);color:#fff;border-color:transparent}\n.fyn-cmp .fyn-card{background:#fff;border-radius:12px;box-shadow:0 10px 15px -3px rgba(0,0,0,.1);overflow:hidden}\n.fyn-cmp .fyn-scroll{overflow-x:auto}.fyn-cmp .fyn-in{min-width:1000px}\n.fyn-cmp .fyn-r{display:grid;grid-template-columns:minmax(230px,1.6fr) repeat(6,minmax(112px,1fr));border-top:1px solid #f0f1f3;transition:background .2s ease}\n.fyn-cmp .fyn-r:hover{background:#fcfcfd}\n.fyn-cmp .fyn-n{position:sticky;left:0;z-index:1;background:#fff;padding:14px 20px;display:flex;align-items:center;font:500 14px/1.35 Outfit,sans-serif;color:#333}\n.fyn-cmp .fyn-c{padding:14px 10px;display:flex;align-items:center;justify-content:center;text-align:center}\n.fyn-cmp .fyc{background:#faf5fc}\n.fyn-cmp .fyn-ck{width:26px;height:26px;border-radius:50%;background:#d1fae5;color:#047857;display:inline-flex;align-items:center;justify-content:center;font:700 13px/1 Outfit,sans-serif}\n.fyn-cmp .fyn-ck.fy{background:linear-gradient(135deg,#8F39AC,#379FD3);color:#fff;box-shadow:0 4px 12px rgba(143,57,172,.25)}\n.fyn-cmp .fyn-x{font:600 14px/1 Outfit,sans-serif;color:#c4c8cf}\n.fyn-cmp .fyn-tx{font:500 13px/1.3 Outfit,sans-serif;color:#4b5563}.fyn-cmp .fyn-tx.fy{font-weight:700;color:#8F39AC}\n.fyn-cmp .fyn-g{display:grid;grid-template-columns:minmax(230px,1.6fr) repeat(6,minmax(112px,1fr));background:#f9fafb;border-top:2p