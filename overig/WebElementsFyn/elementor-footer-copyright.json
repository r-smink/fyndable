     "isInner": false,
     "settings": {
      "html": "<style>\n@keyframes fynSweep{0%{transform:translateX(-100%)}100%{transform:translateX(400%)}}\n@keyframes fynPulse{0%,100%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}50%{box-shadow:0 0 0 6px rgba(16,185,129,0)}}\n.fyn-foot{position:relative;overflow:hidden;isolation:isolate}\n.fyn-foot-deco{position:absolute!important;inset:0!important;margin:0!important;width:100%!important;max-width:none!important;z-index:-1!important;pointer-events:none}\n.fyn-foot-deco .elementor-widget-container{position:absolute;inset:0}\n.fyn-foot-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(135deg,#8F39AC,#379FD3);overflow:hidden}\n.fyn-foot-line span{position:absolute;top:0;left:0;width:25%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent);animation:fynSweep 4s ease-in-out infinite}\n.fyn-foot-word{position:absolute;left:50%;bottom:-.34em;transform:translateX(-50%);font:700 clamp(120px,19vw,280px)/1 Outfit,sans-serif;letter-spacing:-.05em;color:rgba(255,255,255,.035);white-space:nowrap}\n.fyn-foot-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#10b981;margin-right:8px;vertical-align:middle;animation:fynPulse 2s ease-in-out infinite}\n.fyn-foot-links .elementor-icon-list-item{border:2px solid rgba(255,255,255,.12);border-radius:20px;padding:8px 14px!important;transition:all .2s ease}\n.fyn-foot-links .elementor-icon-list-item:hover{background:#8F39AC;border-color:#8F39AC;transform:translateY(-2px)}\n.fyn-foot-links .elementor-icon-list-item:hover .elementor-icon-list-text{color:#fff!important}\n.fyn-foot-top .elementor-icon{background:linear-gradient(135deg,#8F39AC,#379FD3)!important;box-shadow:0 4px 12px rgba(143,57,172,.3);transition:all .2s ease}\n.fyn-foot-top .elementor-icon:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(143,57,172,.45)}\n</style><div class=\"fyn-foot-line\"><span></span></div><div class=\"fyn-foot-word\" aria-hidden=\"true\">fyndable</div>\n<script>(function(){var y=new Date().getFullYear();document.querySelectorAll('.fyn-year').forEach(function(e){e.textContent=y;});document.querySelectorAll('.fyn-foot-top a').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();window.scrollTo({top:0,behavior:'smooth'});});});})();</script>",
